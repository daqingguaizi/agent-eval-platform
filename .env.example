# 被测 Echo 产品的本地访问地址（用于真实浏览器评测）
ECHO_WEB_BASE_URL=http://127.0.0.1:3000

# 被测产品代码位置；本仓库不包含画布产品或 Canvas Agent。
ECHO_TARGET_WEB_ROOT=/absolute/path/to/echo-infinite-canvas/web

# 试点受控媒体资源目录；资源本体不包含在本仓库。
PILOT_RESOURCE_DIR=/absolute/path/to/pilot-media

# 仅在运行真实浏览器试点评测时需要。
ECHO_PILOT_USERNAME=
ECHO_PILOT_PASSWORD=
ECHO_PILOT_INVITE_CODE=

# 仅在连接模型辅助服务时需要。
DEEPSEEK_API_KEY=
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
